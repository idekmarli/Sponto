{
  "expo": {
    "name": "Resellr OS",
    "slug": "resellr-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "resellr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F4F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resellr.os",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of items for your inventory",
        "NSPhotoLibraryUsageDescription": "Select photos from your gallery for listings",
        "NSPhotoLibraryAddUsageDescription": "Save item photos to your gallery"
      }
    },
    "android": {
      "package": "com.resellr.os",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F5F4F2"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F4F2"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1D6F42"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Select photos for your inventory listings",
          "cameraPermission": "Take photos of items to add to inventory"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "resellr-os"
      }
    },
    "owner": "resellr",
    "description": "The smart inventory management app for resellers. Track items, calculate profits, and grow your business.",
    "githubUrl": "https://github.com/resellr/resellr-os",
    "primaryColor": "#6B9B7A"
  }
}
